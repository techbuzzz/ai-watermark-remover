<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WatermarkRemover.Mcp</RootNamespace>
    <!--
      Library project — not a CLI. The `serve-mcp` host lives in
      WatermarkRemover.CLI (see WR-S11) and references this assembly to
      register the tool set via the shared DI extension.
    -->
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WatermarkRemover.Core\WatermarkRemover.Core.csproj" />
    <ProjectReference Include="..\WatermarkRemover.Text\WatermarkRemover.Text.csproj" />
    <ProjectReference Include="..\WatermarkRemover.Metadata\WatermarkRemover.Metadata.csproj" />
    <ProjectReference Include="..\WatermarkRemover.Image\WatermarkRemover.Image.csproj" />
  </ItemGroup>
</Project>
