<Project>
  <!--
    Self-contained, single-file, ReadyToRun-compressed publish profile for
    osx-x64 (Intel macOS). Matches the flags used by the release workflow in
    .github/workflows/release.yml.

    Apple Silicon (osx-arm64) is intentionally not in the supported matrix
    yet; add a sibling profile when the release workflow grows an
    `osx-arm64` leg.

    Usage:
      dotnet publish src/WatermarkRemover.CLI -c Release -p:PublishProfile=osx-x64

    Output: src/WatermarkRemover.CLI/bin/publish/osx-x64/watermarkremover
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>osx-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <UseAppHost>true</UseAppHost>
    <PublishDir>bin\publish\osx-x64\</PublishDir>
  </PropertyGroup>
</Project>
