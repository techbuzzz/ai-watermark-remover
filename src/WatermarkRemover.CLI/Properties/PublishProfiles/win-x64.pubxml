<Project>
  <!--
    Self-contained, single-file, ReadyToRun-compressed publish profile for
    win-x64. Matches the flags used by the release workflow in
    .github/workflows/release.yml so that `dotnet publish -p:PublishProfile=win-x64`
    produces a binary equivalent to the GitHub Release artifact.

    Usage:
      dotnet publish src/WatermarkRemover.CLI -c Release -p:PublishProfile=win-x64

    Output: src/WatermarkRemover.CLI/bin/publish/win-x64/watermarkremover.exe
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <UseAppHost>true</UseAppHost>
    <WindowsPackageType>None</WindowsPackageType>
    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
