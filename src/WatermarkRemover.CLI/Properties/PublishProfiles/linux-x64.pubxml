<Project>
  <!--
    Self-contained, single-file, ReadyToRun-compressed publish profile for
    linux-x64. Matches the flags used by the release workflow in
    .github/workflows/release.yml so that `dotnet publish -p:PublishProfile=linux-x64`
    produces a binary byte-equivalent to the GitHub Release artifact.

    Usage:
      dotnet publish src/WatermarkRemover.CLI -c Release -p:PublishProfile=linux-x64

    The output lands in src/WatermarkRemover.CLI/bin/publish/linux-x64/.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <UseAppHost>true</UseAppHost>
    <PublishDir>bin\publish\linux-x64\</PublishDir>
  </PropertyGroup>
</Project>
