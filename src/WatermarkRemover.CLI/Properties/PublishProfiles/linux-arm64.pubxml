<Project>
  <!--
    Self-contained, single-file, ReadyToRun-compressed publish profile for
    linux-arm64 (e.g. AWS Graviton, Raspberry Pi 5, Apple Silicon under Linux).
    Matches the flags used by the release workflow in
    .github/workflows/release.yml.

    Usage:
      dotnet publish src/WatermarkRemover.CLI -c Release -p:PublishProfile=linux-arm64

    Output: src/WatermarkRemover.CLI/bin/publish/linux-arm64/
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <UseAppHost>true</UseAppHost>
    <PublishDir>bin\publish\linux-arm64\</PublishDir>
  </PropertyGroup>
</Project>
