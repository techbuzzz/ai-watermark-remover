---
import '../styles/global.css';
import Box from '../components/Box.astro';
import TextTab from '../components/tabs/TextTab.astro';
import MarkdownTab from '../components/tabs/MarkdownTab.astro';
import FileTab from '../components/tabs/FileTab.astro';
import ImageTab from '../components/tabs/ImageTab.astro';

const tabs = [
  { id: 'text', label: 'Text' },
  { id: 'markdown', label: 'Markdown' },
  { id: 'file', label: 'File' },
  { id: 'image', label: 'Image' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>WatermarkRemover — clean AI watermarks</title>
    <meta
      name="description"
      content="Strip AI-provenance watermarks from text, markdown, files and images. Plug-and-play UI for the WatermarkRemover HTTP API."
    />
  </head>
  <body>
    <main class="wr-page">
      <div class="wr-container">
        <Box tabs={tabs} active="text">
          <TextTab />
          <MarkdownTab />
          <FileTab />
          <ImageTab />
        </Box>

        <p class="wr-footer">
          Talks to the WatermarkRemover HTTP API. Configure
          <code>PUBLIC_API_URL</code> at build time to re-point. ·
          <a href="https://github.com/techbuzzz/ai-watermark-remover" target="_blank" rel="noopener">Source</a>
          · <span class="muted">API docs (coming soon)</span>
        </p>
      </div>
    </main>

    <script>
      // ARIA-tabs pattern: keyboard nav (←/→) + click + initial active state.
      const box = document.querySelector<HTMLElement>('.wr-box');
      if (box) {
        const tabs = Array.from(box.querySelectorAll<HTMLButtonElement>('.wr-tab'));
        const panels = Array.from(box.querySelectorAll<HTMLElement>('.wr-panel'));

        const activate = (id: string) => {
          tabs.forEach((t) => {
            const sel = t.dataset.tab === id;
            t.setAttribute('aria-selected', String(sel));
            t.tabIndex = sel ? 0 : -1;
            if (sel) t.focus();
          });
          panels.forEach((p) => {
            p.dataset.active = p.dataset.tabPanel === id ? 'true' : 'false';
          });
          box.dataset.activeTab = id;
          // Persist the user's last tab for the next reload.
          try {
            localStorage.setItem('wr.activeTab', id);
          } catch {
            /* localStorage may be blocked */
          }
        };

        // Restore last-active tab, if any.
        let initial = 'text';
        try {
          const saved = localStorage.getItem('wr.activeTab');
          if (saved && tabs.some((t) => t.dataset.tab === saved)) initial = saved;
        } catch {
          /* ignore */
        }
        if (initial !== 'text') activate(initial);

        tabs.forEach((t) => {
          t.addEventListener('click', () => {
            const id = t.dataset.tab;
            if (id) activate(id);
          });
          t.addEventListener('keydown', (e) => {
            const idx = tabs.indexOf(t);
            if (e.key === 'ArrowRight') {
              e.preventDefault();
              const next = tabs[(idx + 1) % tabs.length];
              if (next?.dataset.tab) activate(next.dataset.tab);
            } else if (e.key === 'ArrowLeft') {
              e.preventDefault();
              const prev = tabs[(idx - 1 + tabs.length) % tabs.length];
              if (prev?.dataset.tab) activate(prev.dataset.tab);
            } else if (e.key === 'Home') {
              e.preventDefault();
              const first = tabs[0];
              if (first?.dataset.tab) activate(first.dataset.tab);
            } else if (e.key === 'End') {
              e.preventDefault();
              const last = tabs[tabs.length - 1];
              if (last?.dataset.tab) activate(last.dataset.tab);
            }
          });
        });
      }
    </script>
  </body>
</html>
