# WatermarkRemover web UI configuration
#
# Both variables are PUBLIC (exposed to the browser bundle). Do NOT use
# PUBLIC_API_KEY with a sensitive key in a public-internet deploy — anyone
# can read the built JS. For trusted networks / co-located serve only.

# Where the WatermarkRemover HTTP API lives. Include scheme, no trailing slash.
PUBLIC_API_URL=http://localhost:5080

# Optional. If set, the browser sends it as `X-API-Key` on every request.
# Leave empty / unset for open APIs.
PUBLIC_API_KEY=
